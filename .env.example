# Copy to services/api/.env; never put provider keys in NEXT_PUBLIC_* variables.
LLM_PROVIDER=demo
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
DATABASE_URL=sqlite:///./data/smartboard.db
AUTH_MODE=dev
# For a personal remotely hosted backend, use AUTH_MODE=token and a random secret.
APP_ACCESS_TOKEN=
# Token mode identifies one personal workspace; use OIDC for multiple users.
APP_TENANT=personal-workspace
APP_USER=personal-learner
# For verified JWT authentication, set AUTH_MODE=oidc and all three values:
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
AI_TIMEOUT_SECONDS=60
MAX_BOARD_OBJECTS=500
MAX_SELECTION_OBJECTS=100
MAX_CONTEXT_CHARS=12000
MAX_OUTPUT_TOKENS=1200
# Optional explicit prices for this model, used only for estimated cost accounting.
INPUT_USD_PER_MILLION=
OUTPUT_USD_PER_MILLION=
